# What EAS leaves out of the upload. EAS uses this file instead of .gitignore,
# and its matcher cannot re-include targets/ReportExtension under a
# "targets/*" rule, so the generated targets are listed one by one here.
node_modules/
.expo/
dist/
web-build/
ios/
android/
.idea/
docs/
backend/
.git/

# TEMPORARY: the report extension stays out of store builds until Apple
# approves Family Controls (Distribution) for its App ID (request 3D9M9QX3QF,
# filed 29 Oct 2026). Remove this line to bring the Screen Time panels back.
# See docs/release.md.
targets/ReportExtension/

# Generated by the react-native-device-activity plugin at prebuild.
targets/ActivityMonitorExtension/
targets/ShieldAction/
targets/ShieldConfiguration/

# Local secrets and keys.
.env
.env.*
/firebaseConfig.js
*.p8
*.p12
*.key
*.jks
*.mobileprovision
*.pem
*.log
.DS_Store
