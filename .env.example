# Copy to .env.local (gitignored) and fill in.

# Base URL of the Pledge backend (see backend/README.md). No trailing slash.
EXPO_PUBLIC_API_URL=https://your-backend.vercel.app

# Optional: Stripe publishable key. If omitted the app fetches it from the backend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
