+/// Pledge: a threshold event is only believed when an earlier event of the
+/// same schedule fired today, at least `minGapMS` before now. iOS sometimes
+/// fires thresholds early or all at once; real use cannot climb five minutes
+/// in a few seconds, so a lone or simultaneous threshold is ignored.
+func eventRecordedEarlierToday(activityName: String, eventName: String, minGapMS: Double) -> Bool {
+  guard
+    let firedAt = getLastTriggeredTimeFromUserDefaults(
+      activityName: activityName,
+      callbackName: "eventDidReachThreshold",
+      eventName: eventName
+    )
+  else {
+    return false
+  }
+  let startOfDay = Calendar.current.startOfDay(for: Date()).timeIntervalSince1970 * 1000
+  let now = Date().timeIntervalSince1970 * 1000
+  return firedAt >= startOfDay && now - firedAt >= minGapMS
+}
