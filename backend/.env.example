# Stripe (dashboard > Developers > API keys). Use test keys until launch.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Firebase service account for project "pledgetrial":
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the JSON on one line, or base64-encode it: base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

# Optional
PLEDGE_CURRENCY=eur
# STRIPE_EPHEMERAL_API_VERSION=2024-06-20
# PORT=3000

# Apple Push (deletion detection). Create a key at developer.apple.com > Keys with APNs enabled.
APNS_KEY_ID=
APNS_TEAM_ID=GC2XRZ6HSJ
# Contents of the .p8 file, base64-encoded: base64 -i AuthKey_XXXX.p8
APNS_KEY_P8=
APNS_BUNDLE_ID=com.pledgecompany.pledge
# Vercel sends this as a bearer token when it runs the daily cron.
CRON_SECRET=
